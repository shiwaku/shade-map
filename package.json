{
  "name": "shade-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "さいたま市 建物現況調査データによる時間帯別 日陰マップ (MapLibre GL JS + deck.gl + PMTiles)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "shade": "python3 scripts/precompute_shade.py",
    "tiles": "bash scripts/build_tiles.sh"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.0",
    "@deck.gl/layers": "^9.3.0",
    "@deck.gl/mapbox": "^9.3.0",
    "maplibre-gl": "5.24.0",
    "pmtiles": "^4.4.1"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
